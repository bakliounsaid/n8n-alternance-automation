    {
      "parameters": {
        "jsCode": "const offres = $input.all()\n  .map(item => item.json)\n  .filter(o => o.output)\n  .sort((a, b) => b.output.score - a.output.score);\n\nif (offres.length === 0) {\n  return [{ json: { sujet: \"Aucune offre pertinente aujourd'hui\", html: \"<p>Le workflow a bien tourné, mais aucune offre ne dépasse 7/10.</p>\" } }];\n}\n\nconst liste = arr => (arr ?? []).map(x => `<li>${x}</li>`).join('');\n\nconst blocs = offres.map(o => `\n  <div style=\"border:1px solid #ddd;border-radius:8px;padding:12px;margin-bottom:14px\">\n    <h3 style=\"margin:0\">${o.output.score}/10 — ${o.offer?.title ?? 'Sans titre'}</h3>\n    <p style=\"margin:4px 0;color:#555\">${o.workplace?.name ?? ''} · ${o.workplace?.location?.address ?? ''}</p>\n    <p><em>${o.output.verdict ?? ''}</em></p>\n    <strong>✅ Points forts</strong><ul>${liste(o.output.points_forts)}</ul>\n    <strong>⚠️ Points faibles</strong><ul>${liste(o.output.points_faibles)}</ul>\n    <a href=\"${o.apply?.url ?? '#'}\">Voir l'offre et postuler</a>\n  </div>`).join('');\n\nreturn [{\n  json: {\n    sujet: `🎯 ${offres.length} offre(s) pertinente(s) ce matin`,\n    html: `<h2>Tes offres triées par l'IA</h2>${blocs}`\n  }\n}];"
      },
